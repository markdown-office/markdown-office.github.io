{%- set groups = collections.all | sections -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {% endif %}{{ suite.name }}</title>
    <meta name="description" content="{{ summary }}" />
    <link rel="canonical" href="{{ suite.canonical }}{{ page.url }}" />

    {# The same page as it was written. A machine reading it wants the directive in front of it,
       not a <pre> with HTML escaped inside it. #}
    <link
      rel="alternate"
      type="text/markdown"
      href="{{ page.url }}index.md"
      title="{{ title }} as Markdown"
    />

    <link rel="icon" href="/assets/icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/site.css" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ summary }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ suite.canonical }}{{ page.url }}" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <div class="shell">
      <header class="side">
        <div class="side__bar">
          <a class="side__mark" href="/" aria-label="{{ suite.name }}, home">
            {{ wordmark | safe }}
          </a>

          {# The navigation is a drawer on a narrow screen, and this is the button that opens it.
             It is a popover invoker: the browser opens the drawer, closes it on Escape, closes it
             when the page outside is touched, and moves the focus into it and back — all of it
             without a line of script, which is what the rest of this site is built on. #}
          <button
            class="burger"
            type="button"
            popovertarget="nav-drawer"
            aria-controls="nav-drawer"
          >
            <span class="burger__bars" aria-hidden="true"></span>
            <span>Menu</span>
          </button>
        </div>

        {# The `autofocus` is what puts the focus in the drawer when it opens: a popover that is
           not given one leaves the focus on the button that opened it, and that button is inert
           the moment the drawer is over the page. The browser closes the drawer on Escape and
           gives the focus back to the button it came from. #}
        <div class="drawer" id="nav-drawer" popover>
          <div class="drawer__head">
            <a class="drawer__mark" href="/" aria-label="{{ suite.name }}, home">
              {{ wordmark | safe }}
            </a>
            <button
              class="drawer__close"
              type="button"
              popovertarget="nav-drawer"
              popovertargetaction="hide"
              autofocus
            >
              Close
            </button>
          </div>

          <nav aria-label="Documentation">
            {%- for group in groups %}
            <div class="side__section">
              <h2>{{ group.title }}</h2>
              <p>{{ group.note }}</p>
              <ul>
                {%- for entry in group.pages %}
                <li>
                  <a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}
                    >{{ entry.data.title }}</a
                  >
                </li>
                {%- endfor %}
              </ul>
            </div>
            {%- endfor %}
          </nav>
        </div>
      </header>

      <main id="content" class="main">
        <div class="wrap">
          {%- if section %}
          <div class="topbar">
            <span>{{ section }}</span>
            <span class="topbar__spacer"></span>
            <a href="/llms.txt">llms.txt</a>
            <a href="/llms-full.txt">llms-full.txt</a>
            <a href="/pages.json">pages.json</a>
          </div>
          {%- endif %}

          {{ content | expandExamples | expandTabs | safe }}

          {%- if section %}
          {# Previous and next, computed by a filter: Nunjucks has no `where`, and a
             collection walked by hand in the layout is a loop that has to be
             right on every page. #}
          {%- set neighbours = collections.all | pager(page.url) -%}
          <nav class="pager" aria-label="Page navigation">
            {%- if neighbours.before %}
            <a href="{{ neighbours.before.url }}" rel="prev">
              <span>Previous</span>
              <strong>{{ neighbours.before.data.title }}</strong>
            </a>
            {%- endif %}
            {%- if neighbours.after %}
            <a href="{{ neighbours.after.url }}" rel="next">
              <span>Next</span>
              <strong>{{ neighbours.after.data.title }}</strong>
            </a>
            {%- endif %}
          </nav>

          <p class="colophon">
            Every example on this page was built by the library it documents while this page was
            built. <a href="{{ page.url }}index.md">This page as Markdown</a>.
          </p>
          {%- endif %}
        </div>
      </main>
    </div>
  </body>
</html>