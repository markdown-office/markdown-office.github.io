{
    "name": "markdown-office/documentation",
    "description": "The documentation site for the Markdown Office suite: one generator, the real libraries rendering their own examples.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Graßl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10",
        "markdown-office/commonmark-generic-directives": "0.3.0",
        "markdown-office/markdown-word": "dev-main",
        "markdown-office/markdown-presentation": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../commonmark-generic-directives",
            "options": {
                "symlink": true,
                "versions": {
                    "markdown-office/commonmark-generic-directives": "0.3.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../markdown-word",
            "options": {
                "symlink": true,
                "versions": {
                    "markdown-office/markdown-word": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../markdown-presentation",
            "options": {
                "symlink": true,
                "versions": {
                    "markdown-office/markdown-presentation": "dev-main"
                }
            }
        }
    ],
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "MarkdownOffice\\Documentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownOffice\\Documentation\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "examples": "@php tools/render-examples.php",
        "build": "npm run build",
        "serve": "npm run serve",
        "check": [
            "@php tools/render-examples.php --strict",
            "@php tools/check-command-line.php ../mdoffice",
            "@php tools/check-reference.php",
            "@php tools/check-readme-links.php ../markdown-word ../markdown-presentation ../mdoffice"
        ],
        "check:site": "@php tools/check-site-links.php",
        "check:links": "@php tools/check-readme-links.php ../markdown-word ../markdown-presentation ../mdoffice"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}